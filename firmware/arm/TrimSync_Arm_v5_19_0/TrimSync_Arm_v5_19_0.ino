const char* FW_VERSION="5.19.0-FIXED-REAR-CAMERA-ASSIST";
const char* HOSTNAME="trimsync";
const char* AP_SSID="TrimSync-Arm";
const char* AP_PASS="vthacks26";
const char* WIFI_SSID="Sameer";
const char* WIFI_PASS="Wickey23";
const char* CLOUD_STATUS_URL="https://clip-e.vercel.app/api/arm/status";
const char* CLOUD_COMMAND_URL="https://clip-e.vercel.app/api/arm/command";
const char* CLOUD_ACK_URL="https://clip-e.vercel.app/api/arm/ack";
const char* DEVICE_KEY="123";
const char* DEVICE_ID="arm-01";

constexpr uint8_t SDA_PIN=2,SCL_PIN=1,OE_PIN=4,ESTOP_PIN=5,PCA_ADDR=0x40;
constexpr bool USE_PHYSICAL_ESTOP=false;
constexpr uint8_t ARM_JOINTS=5,ACTUATORS=7,LPL=5,RPL=6;
constexpr uint16_t SERVO_MIN_US=500,SERVO_MAX_US=2500;
constexpr uint32_t CONTROL_MS=10,GYRO_TIMEOUT_MS=400;

enum Mode:uint8_t{HOLD,MANUAL,GYRO,HOME,RETREAT};
struct ServoCfg{uint8_t ch;const char* name;float minD,maxD,home;bool rev;float vmax,amax;};
ServoCfg C[ACTUATORS]={
 {0,"Base",20,160,90,false,150,520},
 {1,"Shoulder",25,150,90,true,125,430},
 {2,"Elbow",20,160,90,true,135,470},
 {3,"Wrist Pitch",25,155,90,false,165,600},
 {4,"Wrist Roll",20,160,90,false,180,680},
 {5,"Left Plunger",0,180,60,false,100,350},
 {6,"Right Plunger",0,180,60,false,100,350}
};

Adafruit_PWMServoDriver pwm(PCA_ADDR); WebServer server(80); DNSServer dns; Preferences prefs;
float cur[ACTUATORS],tgt[ACTUATORS],vel[ACTUATORS],homePose[ARM_JOINTS],retreatPose[ARM_JOINTS];
float safeMin[ARM_JOINTS],safeMax[ARM_JOINTS],joyAnchor[ARM_JOINTS];
float plUp[2]={60,60},plDn[2]={120,120};
bool pcaOK=false,armed=false,estop=false,homeSaved=false,retreatSaved=false;
Mode mode=HOLD; uint32_t lastCtrl=0,lastGyro=0,gyroPackets=0,lastWiFiTry=0;
float speedMul=1.65f,ggain=.72f,gdead=.65f,galpha=.22f,gmax=38.0f;
float elbowMix=.78f,wristMix=.46f,yawMix=.70f;
float fP=0,fR=0,fY=0,lastP=0,lastR=0,lastY=0; bool filterPrimed=false,coordinated=true;
float anchor[ARM_JOINTS]; bool clipperOnlyGyro=true; float joyReach=0; bool cloudEnabled=true; uint32_t cloudOK=0,cloudFail=0; String cloudErr="none";

String modeName(){switch(mode){case MANUAL:return"manual";case GYRO:return"gyro";case HOME:return"home";case RETREAT:return"retreat";default:return"hold";}}
bool physicalStop(){return USE_PHYSICAL_ESTOP&&digitalRead(ESTOP_PIN)==HIGH;}
float clampHardware(uint8_t j,float d){return constrain(d,C[j].minD,C[j].maxD);}
float clampD(uint8_t j,float d){if(j<ARM_JOINTS){float lo=max(C[j].minD,safeMin[j]),hi=min(C[j].maxD,safeMax[j]);if(lo>hi){lo=C[j].minD;hi=C[j].maxD;}return constrain(d,lo,hi);}return clampHardware(j,d);} 
float db(float v,float d){if(fabs(v)<=d)return 0;return v>0?v-d:v+d;}
uint16_t toPWM(float d,const ServoCfg& c){if(c.rev)d=180.0f-d;d=constrain(d,0.0f,180.0f);float us=SERVO_MIN_US+(SERVO_MAX_US-SERVO_MIN_US)*(d/180.0f);return(uint16_t)(us*4096.0f/20000.0f);} 
void writeServo(uint8_t j,float d){if(pcaOK&&armed&&j<ACTUATORS)pwm.setPWM(C[j].ch,0,toPWM(d,C[j]));}
void zeroV(){for(uint8_t i=0;i<ACTUATORS;i++)vel[i]=0;}
void hold(){for(uint8_t i=0;i<ACTUATORS;i++)tgt[i]=cur[i];zeroV();mode=HOLD;}
void disableOut(bool latch){if(latch)estop=true;armed=false;hold();digitalWrite(OE_PIN,HIGH);} 
bool ensureArmed(){if(!pcaOK||estop||physicalStop())return false;if(!armed){digitalWrite(OE_PIN,LOW);armed=true;for(uint8_t i=0;i<ACTUATORS;i++)writeServo(i,cur[i]);}return true;}

void loadPrefs(){prefs.begin("trim515",true);speedMul=constrain(prefs.getFloat("speed",1.65f),.5f,3.0f);ggain=constrain(prefs.getFloat("gain",.72f),.15f,1.5f);gdead=constrain(prefs.getFloat("dead",.65f),0.0f,5.0f);galpha=constrain(prefs.getFloat("alpha",.22f),.05f,.8f);homeSaved=prefs.getBool("homeok",false);retreatSaved=prefs.getBool("retok",false);clipperOnlyGyro=prefs.getBool("clipgyro",true);for(uint8_t i=0;i<ACTUATORS;i++){String k="rev"+String(i);C[i].rev=prefs.getBool(k.c_str(),C[i].rev);}for(uint8_t i=0;i<ARM_JOINTS;i++){String mn="mn"+String(i),mx="mx"+String(i);safeMin[i]=constrain(prefs.getFloat(mn.c_str(),C[i].minD),C[i].minD,C[i].maxD);safeMax[i]=constrain(prefs.getFloat(mx.c_str(),C[i].maxD),C[i].minD,C[i].maxD);if(safeMin[i]>=safeMax[i]-1){safeMin[i]=C[i].minD;safeMax[i]=C[i].maxD;}}for(uint8_t i=0;i<ARM_JOINTS;i++){String h="h"+String(i),r="r"+String(i);homePose[i]=clampD(i,prefs.getFloat(h.c_str(),C[i].home));retreatPose[i]=clampD(i,prefs.getFloat(r.c_str(),C[i].home));}prefs.end();}
void saveTune(){prefs.begin("trim515",false);prefs.putFloat("speed",speedMul);prefs.putFloat("gain",ggain);prefs.putFloat("dead",gdead);prefs.putFloat("alpha",galpha);prefs.end();}
void savePose(bool retreat){prefs.begin("trim515",false);for(uint8_t i=0;i<ARM_JOINTS;i++){float v=cur[i];if(retreat){retreatPose[i]=v;String k="r"+String(i);prefs.putFloat(k.c_str(),v);}else{homePose[i]=v;String k="h"+String(i);prefs.putFloat(k.c_str(),v);}}if(retreat){retreatSaved=true;prefs.putBool("retok",true);}else{homeSaved=true;prefs.putBool("homeok",true);}prefs.end();}
void saveRev(uint8_t j){prefs.begin("trim515",false);String k="rev"+String(j);prefs.putBool(k.c_str(),C[j].rev);prefs.end();}
void saveLimits(uint8_t j){prefs.begin("trim515",false);String mn="mn"+String(j),mx="mx"+String(j);prefs.putFloat(mn.c_str(),safeMin[j]);prefs.putFloat(mx.c_str(),safeMax[j]);prefs.end();}
void saveGyroMode(){prefs.begin("trim515",false);prefs.putBool("clipgyro",clipperOnlyGyro);prefs.end();}

void setManual(uint8_t j,float d){if(j>=ACTUATORS||!ensureArmed())return;if(mode==GYRO)hold();mode=MANUAL;tgt[j]=clampD(j,d);}
void setCalibrationManual(uint8_t j,float d){
  if(j>=ARM_JOINTS||!ensureArmed())return;
  if(mode==GYRO)hold();
  mode=MANUAL;
  // CALIBRATION ONLY: bypass the saved SAFE MIN/MAX envelope,
  // but NEVER bypass the firmware's absolute hardware limits.
  tgt[j]=clampHardware(j,d);
} 
void movePose(float* p,Mode m){if(!ensureArmed())return;tgt[LPL]=plUp[0];tgt[RPL]=plUp[1];for(uint8_t i=0;i<ARM_JOINTS;i++)tgt[i]=clampD(i,p[i]);mode=m;}
void startGyro(){if(!ensureArmed())return;for(uint8_t i=0;i<ARM_JOINTS;i++)anchor[i]=cur[i];fP=fR=fY=0;filterPrimed=false;lastGyro=millis();mode=GYRO;}
void stopGyro(){if(mode==GYRO)hold();}
void recenterGyro(){if(mode!=GYRO)return;for(uint8_t i=0;i<ARM_JOINTS;i++)anchor[i]=cur[i];fP=fR=fY=0;filterPrimed=false;}
void applyGyro(float p,float r,float y){lastP=p;lastR=r;lastY=y;gyroPackets++;lastGyro=millis();if(mode!=GYRO)startGyro();if(mode!=GYRO)return;p=constrain(db(p,gdead),-gmax,gmax);r=constrain(db(r,gdead),-gmax,gmax);y=constrain(db(y,gdead),-gmax,gmax);if(!filterPrimed){fP=p;fR=r;fY=y;filterPrimed=true;}else{fP+=galpha*(p-fP);fR+=galpha*(r-fR);fY+=galpha*(y-fY);}// Phone orientation follows the clipper directly:
  // pitch forward -> clipper pitch forward
  // roll left/right -> clipper roll left/right
  // yaw left/right -> base yaw left/right in full-arm mode
  float P=fP*ggain,R=fR*ggain,Y=fY*ggain*yawMix;if(clipperOnlyGyro){tgt[3]=clampD(3,anchor[3]+P);tgt[4]=clampD(4,anchor[4]+R);}else{tgt[1]=clampD(1,anchor[1]-P);if(coordinated){tgt[2]=clampD(2,anchor[2]+P*elbowMix);tgt[3]=clampD(3,anchor[3]+P*wristMix);}tgt[4]=clampD(4,anchor[4]+R);tgt[0]=clampD(0,anchor[0]+Y);}}
void captureJoyAnchor(){for(uint8_t i=0;i<ARM_JOINTS;i++)joyAnchor[i]=cur[i];joyReach=0;}
void applyReach(float f){if(!ensureArmed()||estop||physicalStop())return;f=constrain(f,-1.0f,1.0f);if(fabs(f)<.04f){joyReach=0;return;}joyReach=f;tgt[1]=clampD(1,joyAnchor[1]+f*18.0f);tgt[2]=clampD(2,joyAnchor[2]-f*24.0f);if(mode!=GYRO)mode=MANUAL;}
void approachNudge(float f){if(!ensureArmed()||estop||physicalStop())return;f=constrain(f,-.20f,.20f);tgt[1]=clampD(1,tgt[1]+f*10.0f);tgt[2]=clampD(2,tgt[2]-f*15.0f);if(mode!=GYRO)mode=MANUAL;}
void updateMotion(){uint32_t now=millis();if(now-lastCtrl<CONTROL_MS)return;float dt=(now-lastCtrl)/1000.0f;lastCtrl=now;dt=constrain(dt,.001f,.05f);if(physicalStop()){disableOut(true);return;}if(armed&&mode==GYRO&&now-lastGyro>GYRO_TIMEOUT_MS){Serial.println("GYRO WATCHDOG -> HOLD");hold();}if(!armed)return;for(uint8_t i=0;i<ACTUATORS;i++){float e=tgt[i]-cur[i];if(fabs(e)<.10f&&fabs(vel[i])<.45f){cur[i]=tgt[i];vel[i]=0;writeServo(i,cur[i]);continue;}float vmax=C[i].vmax*speedMul,amax=C[i].amax*speedMul;float dv=constrain(e*7.0f,-vmax,vmax);vel[i]+=constrain(dv-vel[i],-amax*dt,amax*dt);float st=vel[i]*dt;if((e>0&&st>e)||(e<0&&st<e)){st=e;vel[i]=0;}cur[i]=clampHardware(i,cur[i]+st);writeServo(i,cur[i]);}if(mode==HOME||mode==RETREAT){bool done=true;for(uint8_t i=0;i<ARM_JOINTS;i++)if(fabs(tgt[i]-cur[i])>.55f)done=false;if(done){mode=HOLD;zeroV();}}}

void cors(){server.sendHeader("Access-Control-Allow-Origin","*");server.sendHeader("Cache-Control","no-store");}
void sendJ(JsonDocument& d,int code=200){String s;serializeJson(d,s);cors();server.send(code,"application/json",s);}void ok(const char*m="ok"){JsonDocument d;d["ok"]=true;d["message"]=m;sendJ(d);}void err(const char*m,int c=400){JsonDocument d;d["ok"]=false;d["error"]=m;sendJ(d,c);} 
void status(){JsonDocument d;d["ok"]=true;d["firmware"]=FW_VERSION;d["pca"]=pcaOK;d["armed"]=armed;d["estop"]=estop||physicalStop();d["mode"]=modeName();d["speed"]=speedMul;d["gyroPackets"]=gyroPackets;d["gyroAgeMs"]=gyroPackets?millis()-lastGyro:0;d["pitch"]=lastP;d["roll"]=lastR;d["yaw"]=lastY;d["gyroGain"]=ggain;d["gyroDeadband"]=gdead;d["gyroAlpha"]=galpha;d["gyroCoordinated"]=coordinated;d["clipperOnlyGyro"]=clipperOnlyGyro;d["joystickReach"]=joyReach;JsonArray a=d["angles"].to<JsonArray>(),t=d["targets"].to<JsonArray>(),rv=d["reversed"].to<JsonArray>(),mn=d["safeMin"].to<JsonArray>(),mx=d["safeMax"].to<JsonArray>();for(uint8_t i=0;i<ACTUATORS;i++){a.add(cur[i]);t.add(tgt[i]);rv.add(C[i].rev);if(i<ARM_JOINTS){mn.add(safeMin[i]);mx.add(safeMax[i]);}}d["homeSaved"]=homeSaved;d["retreatSaved"]=retreatSaved;JsonObject n=d["network"].to<JsonObject>();n["ap"]=AP_SSID;n["apIp"]=WiFi.softAPIP().toString();n["staConnected"]=WiFi.status()==WL_CONNECTED;n["staIp"]=WiFi.status()==WL_CONNECTED?WiFi.localIP().toString():"-";n["rssi"]=WiFi.status()==WL_CONNECTED?WiFi.RSSI():0;JsonObject cl=d["cloud"].to<JsonObject>();cl["enabled"]=cloudEnabled;cl["statusOK"]=cloudOK;cl["statusFail"]=cloudFail;cl["lastError"]=cloudErr;sendJ(d);} 

String cloudBody(){JsonDocument d;d["device_id"]=DEVICE_ID;d["firmware"]=FW_VERSION;d["mode"]=modeName();d["armed"]=armed;d["pca_ready"]=pcaOK;d["estop"]=estop||physicalStop();d["wifi_rssi"]=WiFi.status()==WL_CONNECTED?WiFi.RSSI():0;JsonArray a=d["joint_deg"].to<JsonArray>(),t=d["target_deg"].to<JsonArray>();for(uint8_t i=0;i<ARM_JOINTS;i++){a.add(cur[i]);t.add(tgt[i]);}String s;serializeJson(d,s);return s;}
bool cpost(const char* url,const String& body,String* resp=nullptr){WiFiClientSecure c;c.setInsecure();HTTPClient h;if(!h.begin(c,url)){cloudErr="begin failed";return false;}h.setTimeout(3000);h.addHeader("Content-Type","application/json");h.addHeader("x-trimsync-device-key",DEVICE_KEY);h.addHeader("x-trimsync-device-id",DEVICE_ID);int code=h.POST(body);if(resp)*resp=h.getString();bool good=code>=200&&code<300;cloudErr=good?"none":"HTTP "+String(code);h.end();return good;}
bool cget(String url,String& resp){WiFiClientSecure c;c.setInsecure();HTTPClient h;if(!h.begin(c,url))return false;h.setTimeout(2500);h.addHeader("x-trimsync-device-key",DEVICE_KEY);h.addHeader("x-trimsync-device-id",DEVICE_ID);int code=h.GET();resp=code==204?"":h.getString();h.end();return code>=200&&code<300;}
void execCloud(String cmd,JsonObject args){if(cmd=="hold")hold();else if(cmd=="home")movePose(homePose,HOME);else if(cmd=="retreat"&&retreatSaved)movePose(retreatPose,RETREAT);else if(cmd=="approach_nudge")approachNudge(args["forward"]|0.0f);else if(cmd=="emergency_stop")disableOut(true);else if(cmd=="stop_auto")hold();}
void ackCloud(String id,bool good){JsonDocument d;d["id"]=id;d["device_id"]=DEVICE_ID;d["ok"]=good;String b;serializeJson(d,b);cpost(CLOUD_ACK_URL,b);}
void cloudTask(void*){uint32_t ls=0,lc=0;for(;;){if(cloudEnabled&&WiFi.status()==WL_CONNECTED){uint32_t now=millis();if(now-ls>=1000){ls=now;if(cpost(CLOUD_STATUS_URL,cloudBody()))cloudOK++;else cloudFail++;}if(now-lc>=650){lc=now;String body;if(cget(String(CLOUD_COMMAND_URL)+"?device="+DEVICE_ID,body)&&body.length()){JsonDocument d;if(deserializeJson(d,body)==DeserializationError::Ok){String cmd=d["command"]|"",id=d["id"]|"";JsonObject args=d["args"].is<JsonObject>()?d["args"].as<JsonObject>():JsonObject();if(cmd.length()){execCloud(cmd,args);ackCloud(id,true);}}}}}vTaskDelay(pdMS_TO_TICKS(50));}}

