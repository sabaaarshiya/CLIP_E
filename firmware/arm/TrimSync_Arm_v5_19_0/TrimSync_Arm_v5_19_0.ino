/* TrimSync Arm v5.19.0 — Calibration One Slider
   ESP32-S3 + PCA9685
   SDA=GPIO2, SCL=GPIO1, OE=GPIO4, PCA=0x40
   CH0 Base, CH1 Shoulder, CH2 Elbow, CH3 Wrist Pitch,
   CH4 Wrist Roll, CH5 Left Plunger, CH6 Right Plunger
*/
#include <Arduino.h>
#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <HTTPClient.h>
#include <WebServer.h>
#include <DNSServer.h>
