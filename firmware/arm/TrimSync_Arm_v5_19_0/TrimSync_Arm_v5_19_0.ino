.calHead{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:6px}.calHead span{font-size:10px;color:var(--m)}.calNow{color:var(--a)!important;font-weight:800}.calVal{font-size:18px;color:var(--a);font-weight:900;margin:8px 0}.calMeta{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:8px 0 10px}.calMeta div{border:1px solid #1e4057;border-radius:8px;padding:8px;background:#09243a}.calMeta span{display:block;color:var(--m);font-size:9px}.calBtns{display:grid;grid-template-columns:1fr 1fr;gap:8px}.calBtns button{padding:10px}.calBtns .primary{background:#123f35;color:#7be3bb;border-color:#275c4e}.calBtns .warn{background:#4b3316;color:#ffd083}.calHint{font-size:10px;color:var(--m);margin-top:8px;line-height:1.4}</style></head><body><header><div class="brand">TRIMSYNC<small>ARM CONTROL</small></div><div id="conn" class="badge">CONNECTING</div></header><div class="wrap"><h1>Arm Controller</h1><div class="card"><div class="grid"><div class="metric"><span>MODE</span><b id="mode">—</b></div><div class="metric"><span>ARM</span><b id="armed">—</b></div><div class="metric"><span>PCA</span><b id="pca">—</b></div><div class="metric"><span>GYRO</span><b id="gp">—</b></div></div><div class="row" style="margin-top:10px"><button class="good" onclick="post('/api/arm')">ENABLE</button><button onclick="post('/api/hold')">HOLD</button><button class="primary" onclick="post('/api/home')">HOME</button><button class="warn" onclick="post('/api/retreat')">RETREAT</button></div></div><div class="tabs"><button class="active" onclick="tab('manual',this)">MANUAL</button><button onclick="tab('gyro',this)">GYRO</button><button onclick="tab('calibration',this)">CALIBRATE</button><button onclick="tab('setup',this)">SETUP</button><button onclick="tab('network',this)">NETWORK</button></div>
<section id="manual" class="panel active"><div class="card"><h2>Manual Control</h2><div id="joints"></div></div><div class="card"><h2>Plungers</h2><div class="row"><button onclick="pl(0,'up')">LEFT UP</button><button onclick="pl(0,'down')">LEFT DOWN</button><button onclick="pl(1,'up')">RIGHT UP</button><button onclick="pl(1,'down')">RIGHT DOWN</button></div></div></section>
<section id="gyro" class="panel"><div class="card"><h2>Phone Gyro</h2><div class="notice">ENABLE PHONE MOTION → hold neutral → START GYRO. This version sends orientation at a fixed 20 Hz and the ESP32 runs the servo loop at 100 Hz.</div><div class="sensor"><div><span>PITCH</span><b id="pitch">0°</b></div><div><span>ROLL</span><b id="roll">0°</b></div><div><span>YAW</span><b id="yaw">0°</b></div></div><div id="gd" class="notice">Motion not enabled.</div><div class="row" style="margin-top:10px"><button onclick="enableMotion()">ENABLE PHONE MOTION</button><button onclick="recenter()">RECENTER</button></div><button id="gb" class="good big" onclick="toggleGyro()">START GYRO</button><div class="set"><label><b>Sensitivity</b><span id="gv">.72</span></label><input id="gain" type="range" min=".2" max="1.3" step=".02" value=".72" oninput="gv.textContent=this.value;tune()"></div><div class="set"><label><b>Speed</b><span id="sv">1.65x</span></label><input id="speed" type="range" min=".5" max="3" step=".05" value="1.65" oninput="sv.textContent=this.value+'x';tune()"></div><div class="set"><label><b>Smoothing</b><span id="av">.22</span></label><input id="alpha" type="range" min=".08" max=".55" step=".01" value=".22" oninput="av.textContent=this.value;tune()"></div><div class="set"><label><b>Deadzone</b><span id="dv">.65°</span></label><input id="dead" type="range" min="0" max="4" step=".05" value=".65" oninput="dv.textContent=this.value+'°';tune()"></div><label><input id="coord" type="checkbox" checked onchange="tune()"> Coordinated shoulder + elbow + wrist</label><div class="card"><h2>Gyro Mode</h2><div class="row"><button id="fullBtn" onclick="gyroMode(false)">FULL ARM</button><button id="clipBtn" class="primary" onclick="gyroMode(true)">CLIPPER ONLY</button></div><div class="notice">Clipper-only: phone controls Wrist Pitch + Wrist Roll. Shoulder + Elbow stay under joystick/manual control.</div></div><div class="card"><h2>Forward / Back Reach</h2><div id="joy" class="joy"><div id="knob" class="knob">↕</div></div><div id="joyv" class="notice">CENTER</div></div></div></section>
<section id="calibration" class="panel"><div class="card"><h2>Safe Motion Calibration</h2><div class="notice"><b>Calibration has full travel inside the firmware hardware range.</b> The calibration slider intentionally ignores your previously saved SAFE MIN/MAX so you can move past an old boundary and redefine it. Press <b>SAVE SAFE MIN</b> or <b>SAVE SAFE MAX</b> at the desired position. Everywhere outside this CALIBRATION page, your saved limits remain active for Manual, Gyro, Joystick, Home, Retreat, and camera-assist nudges.</div><div id="calList"></div><div class="row"><button class="stop" onclick="resetCal()">RESET TO FULL HARDWARE LIMITS</button><button onclick="post('/api/hold')">HOLD CURRENT POSITION</button></div></div></section><section id="setup" class="panel"><div class="card"><h2>Home + Safe Retreat</h2><div class="notice">E-STOP disables outputs immediately. SAFE RETREAT is the saved waypoint for backing away; it is intentionally separate from E-STOP.</div><div class="row" style="margin-top:10px"><button onclick="post('/api/home/save')">SAVE HOME</button><button class="primary" onclick="post('/api/home')">GO HOME</button><button onclick="post('/api/retreat/save')">SAVE RETREAT</button><button class="warn" onclick="post('/api/retreat')">GO RETREAT</button></div></div><div class="card"><h2>Servo Direction</h2><div id="setupList"></div></div></section>
<section id="network" class="panel"><div class="card"><h2>Network</h2><div id="net" class="net">Loading...</div></div></section></div><footer><div><button onclick="post('/api/hold')">HOLD</button><button class="warn" onclick="post('/api/retreat')">RETREAT</button><button class="stop" onclick="post('/api/estop')">E-STOP</button></div></footer>
<script>
const N=['Base','Shoulder','Elbow','Wrist Pitch','Wrist Roll','Left Plunger','Right Plunger'];let raw={p:0,r:0,y:0},neu={p:0,r:0,y:0},motion=false,gyro=false,lastSlide=0,timer=null;const q=id=>document.getElementById(id);function tab(id,b){document.querySelectorAll('.panel').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.tabs button').forEach(x=>x.classList.remove('active'));q(id).classList.add('active');b.classList.add('active')}async function post(u){const r=await fetch(u,{method:'POST',cache:'no-store'});const j=await r.json();if(!r.ok)throw Error(j.error||r.status);return j}function diff(a,b){let d=a-b;while(d>180)d-=360;while(d<-180)d+=360;return d}function build(){let h='',s='';N.forEach((n,i)=>{h+=`<div class="joint"><div class="jt"><b>${n}</b><span id="v${i}">90°</span></div><input id="j${i}" type="range" min="${i<5?20:0}" max="${i<5?160:180}" step=".5" value="90" oninput="manual(${i},this.value)"></div>`;s+=`<div class="setup"><b>${n}</b><span id="r${i}">—</span><button onclick="rev(${i})">TOGGLE</button></div>`});q('joints').innerHTML=h;q('setupList').innerHTML=s;let c='';N.slice(0,5).forEach((n,i)=>{c+=`<div class="cal"><div class="calHead"><b>${n}</b><span id="cur${i}" class="calNow">CURRENT —</span></div><div class="calVal" id="cval${i}">90.0°</div><input id="cal${i}" type="range" min="0" max="180" step=".5" value="90" oninput="calMove(${i},this.value)"><div class="calMeta"><div><span>SAFE MIN</span><b id="mnv${i}">—</b></div><div><span>SAFE MAX</span><b id="mxv${i}">—</b></div></div><div class="calBtns"><button class="primary" onclick="saveCalMin(${i})">SAVE SAFE MIN</button><button class="warn" onclick="saveCalMax(${i})">SAVE SAFE MAX</button></div><div class="calHint">CALIBRATION OVERRIDE: this slider may move beyond the saved safe envelope, but never beyond the firmware's absolute hardware range. Save the new MIN or MAX when you reach the safe boundary.</div></div>`});q('calList').innerHTML=c}
async function manual(j,v){q('v'+j).textContent=(+v).toFixed(1)+'°';let n=Date.now();if(n-lastSlide<45)return;lastSlide=n;try{await post(`/api/joint?j=${j}&deg=${v}`)}catch{}}
async function calMove(j,v){if(q('cval'+j))q('cval'+j).textContent=(+v).toFixed(1)+'°';let n=Date.now();if(n-lastSlide<45)return;lastSlide=n;try{await post(`/api/calibration/move?j=${j}&deg=${v}`)}catch{}}
async function pl(side,state){try{await post(`/api/plunger?side=${side}&state=${state}`)}catch{}}
async function rev(j){if(!confirm('Disable outputs and reverse '+N[j]+'?'))return;await post('/api/reverse?j='+j);await stat()}
async function saveCalMin(j){let mn=+q('cal'+j).value;let mx=window.armStatus&&window.armStatus.safeMax?+window.armStatus.safeMax[j]:180;if(mn>=mx)return alert('Safe min must be below the current safe max.');await post(`/api/calibration?j=${j}&min=${mn}&max=${mx}`);await stat()}
async function saveCalMax(j){let mx=+q('cal'+j).value;let mn=window.armStatus&&window.armStatus.safeMin?+window.armStatus.safeMin[j]:0;if(mn>=mx)return alert('Safe max must be above the current safe min.');await post(`/api/calibration?j=${j}&min=${mn}&max=${mx}`);await stat()}
async function resetCal(){if(confirm('Reset all safe limits?')){await post('/api/calibration/reset');await stat()}}
async function gyroMode(x){await post('/api/gyro/mode?clipperOnly='+(x?1:0));await post('/api/motion/recenter').catch(()=>{});await stat()}
let joyPtr=null,joyCentered=true;function setupJoy(){let p=q('joy'),k=q('knob');if(!p)return;function setY(y){let r=p.getBoundingClientRect(),m=(r.height-70)/2,dy=Math.max(-m,Math.min(m,y-(r.top+r.height/2)));k.style.top=(r.height/2-35+dy)+'px';let f=-dy/m;if(Math.abs(f)<.05)f=0;q('joyv').textContent=f>0?'FORWARD '+Math.round(f*100)+'%':f<0?'BACK '+Math.round(-f*100)+'%':'CENTER';fetch('/api/joystick?forward='+f.toFixed(3),{method:'POST'}).catch(()=>{})}function center(){k.style.top='49px';q('joyv').textContent='CENTER';fetch('/api/joystick?forward=0',{method:'POST'}).catch(()=>{})}p.addEventListener('pointerdown',e=>{joyPtr=e.pointerId;p.setPointerCapture(e.pointerId);setY(e.clientY)});p.addEventListener('pointermove',e=>{if(e.pointerId===joyPtr)setY(e.clientY)});p.addEventListener('pointerup',e=>{joyPtr=null;center()});p.addEventListener('pointercancel',e=>{joyPtr=null;center()})}async function enableMotion(){if(typeof DeviceOrientationEvent==='undefined'){q('gd').textContent='DeviceOrientationEvent unavailable.';return}try{if(typeof DeviceOrientationEvent.requestPermission==='function'){let x=await DeviceOrientationEvent.requestPermission();if(x!=='granted')throw Error('permission '+x)}if(!motion){window.addEventListener('deviceorientation',e=>{raw={p:+e.beta||0,r:+e.gamma||0,y:+e.alpha||0};q('pitch').textContent=raw.p.toFixed(1)+'°';q('roll').textContent=raw.r.toFixed(1)+'°';q('yaw').textContent=raw.y.toFixed(1)+'°'},true);motion=true}q('gd').textContent='Orientation active. Hold neutral and START GYRO.'}catch(e){q('gd').textContent='Sensor error: '+e.message}}function neutral(){neu={...raw}}async function toggleGyro(){if(!motion){q('gd').textContent='Enable phone motion first.';return}if(!gyro){neutral();await post('/api/motion/start');gyro=true;q('gb').textContent='STOP GYRO';q('gb').className='stop big';q('gd').textContent='GYRO ACTIVE — fixed 20 Hz.'}else{gyro=false;await post('/api/motion/stop');q('gb').textContent='START GYRO';q('gb').className='good big';q('gd').textContent='Gyro stopped.'}}async function recenter(){neutral();try{await post('/api/motion/recenter')}catch{}q('gd').textContent='Neutral + arm anchor recentered.'}setInterval(async()=>{if(!gyro||!motion)return;let p=raw.p-neu.p,r=raw.r-neu.r,y=diff(raw.y,neu.y);try{await fetch(`/api/orient?pitch=${p.toFixed(2)}&roll=${r.toFixed(2)}&yaw=${y.toFixed(2)}`,{method:'POST',cache:'no-store'})}catch{}},50);function tune(){clearTimeout(timer);timer=setTimeout(async()=>{let u=`/api/tune?gain=${q('gain').value}&speed=${q('speed').value}&alpha=${q('alpha').value}&deadband=${q('dead').value}&coordinate=${q('coord').checked?1:0}`;try{await post(u)}catch{}},120)}
async function stat(){try{let r=await fetch('/api/status?t='+Date.now(),{cache:'no-store'}),x=await r.json();window.armStatus=x;q('conn').textContent=x.estop?'E-STOP':'CONNECTED';q('conn').className='badge '+(x.estop?'err':'ok');q('mode').textContent=x.mode.toUpperCase();q('armed').textContent=x.armed?'ENABLED':'DISABLED';q('pca').textContent=x.pca?'ONLINE':'OFFLINE';q('gp').textContent=x.gyroPackets||0;x.angles.forEach((v,i)=>{let sl=q('j'+i),tx=q('v'+i),csl=q('cal'+i),cur=q('cur'+i),cv=q('cval'+i);if(sl&&document.activeElement!==sl)sl.value=v;if(tx)tx.textContent=(+v).toFixed(1)+'°';if(csl&&document.activeElement!==csl)csl.value=v;if(cur)cur.textContent='CURRENT '+(+v).toFixed(1)+'°';if(cv&&document.activeElement!==csl)cv.textContent=(+v).toFixed(1)+'°'});x.reversed.forEach((v,i)=>{if(q('r'+i))q('r'+i).textContent=v?'REVERSED':'NORMAL'});if(x.safeMin)x.safeMin.forEach((v,i)=>{if(q('mnv'+i))q('mnv'+i).textContent=(+v).toFixed(1)+'°';if(q('mxv'+i))q('mxv'+i).textContent=(+x.safeMax[i]).toFixed(1)+'°'});if(q('fullBtn')){q('fullBtn').className=x.clipperOnlyGyro?'':'primary';q('clipBtn').className=x.clipperOnlyGyro?'primary':''};q('gain').value=x.gyroGain;q('speed').value=x.speed;q('alpha').value=x.gyroAlpha;q('dead').value=x.gyroDeadband;q('gv').textContent=(+x.gyroGain).toFixed(2);q('sv').textContent=(+x.speed).toFixed(2)+'x';q('av').textContent=(+x.gyroAlpha).toFixed(2);q('dv').textContent=(+x.gyroDeadband).toFixed(2)+'°';q('coord').checked=!!x.gyroCoordinated;q('net').textContent=`Firmware: ${x.firmware}
Fallback: ${x.network.ap} @ ${x.network.apIp}
Normal Wi-Fi: ${x.network.staConnected?x.network.staIp:'offline'}
RSSI: ${x.network.rssi} dBm

Cloud OK: ${x.cloud.statusOK}
Cloud failures: ${x.cloud.statusFail}
Last cloud error: ${x.cloud.lastError}

Home saved: ${x.homeSaved}
Retreat saved: ${x.retreatSaved}
Gyro packets: ${x.gyroPackets}
Gyro age: ${x.gyroAgeMs} ms`}catch(e){q('conn').textContent='DISCONNECTED';q('conn').className='badge err'}}
build();setupJoy();stat();setInterval(stat,600);
</script></body></html>)HTML";}

void routes(){server.on("/",HTTP_GET,[]{cors();server.send(200,"text/html",ui());});server.on("/api/status",HTTP_GET,status);server.on("/api/arm",HTTP_POST,[]{if(ensureArmed())ok("armed");else err("cannot arm",409);});server.on("/api/hold",HTTP_POST,[]{hold();ok("holding");});server.on("/api/estop",HTTP_POST,[]{disableOut(true);ok("E-stop latched");});server.on("/api/reset",HTTP_POST,[]{estop=false;armed=false;digitalWrite(OE_PIN,HIGH);hold();ok("stop reset");});server.on("/api/home",HTTP_POST,[]{movePose(homePose,HOME);ok("home requested");});server.on("/api/home/save",HTTP_POST,[]{savePose(false);ok("home saved");});server.on("/api/retreat",HTTP_POST,[]{if(!retreatSaved){err("No retreat waypoint saved",409);return;}movePose(retreatPose,RETREAT);ok("retreat requested");});server.on("/api/retreat/save",HTTP_POST,[]{savePose(true);ok("retreat saved");});server.on("/api/joint",HTTP_POST,[]{if(!server.hasArg("j")||!server.hasArg("deg")){err("Need j,deg");return;}int j=server.arg("j").toInt();if(j<0||j>=ACTUATORS){err("bad joint");return;}setManual(j,server.arg("deg").toFloat());ok();});
server.on("/api/calibration/move",HTTP_POST,[]{if(!server.hasArg("j")||!server.hasArg("deg")){err("Need j,deg");return;}int j=server.arg("j").toInt();if(j<0||j>=ARM_JOINTS){err("bad joint");return;}setCalibrationManual(j,server.arg("deg").toFloat());ok("calibration move");});server.on("/api/plunger",HTTP_POST,[]{if(!server.hasArg("side")||!server.hasArg("state")){err("Need side,state");return;}int s=server.arg("side").toInt();if(s<0||s>1||!ensureArmed()){err("bad plunger",409);return;}uint8_t j=s?RPL:LPL;tgt[j]=server.arg("state")=="down"?plDn[s]:plUp[s];mode=MANUAL;ok();});server.on("/api/orient",HTTP_POST,[]{if(!server.hasArg("pitch")||!server.hasArg("roll")||!server.hasArg("yaw")){err("Need pitch roll yaw");return;}applyGyro(server.arg("pitch").toFloat(),server.arg("roll").toFloat(),server.arg("yaw").toFloat());ok();});server.on("/api/tune",HTTP_POST,[]{if(server.hasArg("gain"))ggain=constrain(server.arg("gain").toFloat(),.15f,1.5f);if(server.hasArg("speed"))speedMul=constrain(server.arg("speed").toFloat(),.5f,3.0f);if(server.hasArg("alpha"))galpha=constrain(server.arg("alpha").toFloat(),.05f,.8f);if(server.hasArg("deadband"))gdead=constrain(server.arg("deadband").toFloat(),0.0f,5.0f);if(server.hasArg("coordinate"))coordinated=server.arg("coordinate")=="1";saveTune();ok();});server.on("/api/reverse",HTTP_POST,[]{if(!server.hasArg("j")){err("Need j");return;}int j=server.arg("j").toInt();if(j<0||j>=ACTUATORS){err("bad joint");return;}disableOut(false);C[j].rev=!C[j].rev;saveRev(j);ok("reversed; outputs disabled");});server.on("/api/calibration",HTTP_POST,[]{if(!server.hasArg("j")){err("Need j");return;}int j=server.arg("j").toInt();if(j<0||j>=ARM_JOINTS){err("bad joint");return;}float mn=server.hasArg("min")?server.arg("min").toFloat():safeMin[j],mx=server.hasArg("max")?server.arg("max").toFloat():safeMax[j];mn=constrain(mn,C[j].minD,C[j].maxD);mx=constrain(mx,C[j].minD,C[j].maxD);if(mn>=mx-1){err("min must be below max");return;}safeMin[j]=mn;safeMax[j]=mx;tgt[j]=clampD(j,tgt[j]);if(cur[j]<mn||cur[j]>mx)disableOut(false);saveLimits(j);ok("limits saved");});server.on("/api/calibration/reset",HTTP_POST,[]{disableOut(false);prefs.begin("trim515",false);for(uint8_t i=0;i<ARM_JOINTS;i++){safeMin[i]=C[i].minD;safeMax[i]=C[i].maxD;String mn="mn"+String(i),mx="mx"+String(i);prefs.putFloat(mn.c_str(),safeMin[i]);prefs.putFloat(mx.c_str(),safeMax[i]);}prefs.end();ok("limits reset");});server.on("/api/gyro/mode",HTTP_POST,[]{if(!server.hasArg("clipperOnly")){err("Need clipperOnly");return;}clipperOnlyGyro=server.arg("clipperOnly")=="1";saveGyroMode();if(mode==GYRO)recenterGyro();ok(clipperOnlyGyro?"clipper-only":"full-arm");});server.on("/api/joystick",HTTP_POST,[]{if(!server.hasArg("forward")){err("Need forward");return;}static bool centered=true;float f=constrain(server.arg("forward").toFloat(),-1.0f,1.0f);if(fabs(f)>=.04f&&centered){captureJoyAnchor();centered=false;}if(fabs(f)<.04f){centered=true;joyReach=0;ok("center");return;}applyReach(f);ok("reach");});server.on("/api/motion/start",HTTP_POST,[]{startGyro();if(mode==GYRO)ok("gyro started");else err("gyro failed",409);});server.on("/api/motion/stop",HTTP_POST,[]{stopGyro();ok("gyro stopped");});server.on("/api/motion/recenter",HTTP_POST,[]{recenterGyro();ok("recentered");});server.begin();}

void setupWiFi(){WiFi.mode(WIFI_AP_STA);WiFi.setSleep(false);WiFi.softAP(AP_SSID,AP_PASS);dns.start(53,"*",WiFi.softAPIP());Serial.printf("Fallback AP %s @ %s\n",AP_SSID,WiFi.softAPIP().toString().c_str());WiFi.begin(WIFI_SSID,WIFI_PASS);uint32_t s=millis();while(WiFi.status()!=WL_CONNECTED&&millis()-s<12000){delay(250);Serial.print('.');}Serial.println();if(WiFi.status()==WL_CONNECTED){Serial.printf("Wi-Fi %s\n",WiFi.localIP().toString().c_str());MDNS.begin(HOSTNAME);}else Serial.println("STA offline; fallback AP remains available");}
void maintainWiFi(){if(WiFi.status()==WL_CONNECTED)return;if(millis()-lastWiFiTry>15000){lastWiFiTry=millis();WiFi.disconnect();WiFi.begin(WIFI_SSID,WIFI_PASS);}}

void setup(){Serial.begin(115200);delay(900);Serial.println("\nTrimSync Arm v5.19.0 Calibration One Slider");pinMode(OE_PIN,OUTPUT);digitalWrite(OE_PIN,HIGH);if(USE_PHYSICAL_ESTOP)pinMode(ESTOP_PIN,INPUT_PULLDOWN);Wire.begin(SDA_PIN,SCL_PIN);Wire.setClock(400000);Wire.beginTransmission(PCA_ADDR);pcaOK=Wire.endTransmission()==0;if(pcaOK){pwm.begin();pwm.setOscillatorFrequency(27000000);pwm.setPWMFreq(50);Serial.println("PCA9685 ONLINE");}else Serial.println("PCA9685 NOT FOUND");loadPrefs();for(uint8_t i=0;i<ACTUATORS;i++){float st=i<ARM_JOINTS?homePose[i]:plUp[i-ARM_JOINTS];cur[i]=clampD(i,st);tgt[i]=cur[i];vel[i]=0;}setupWiFi();routes();xTaskCreatePinnedToCore(cloudTask,"cloud",8192,nullptr,1,nullptr,0);lastCtrl=millis();Serial.println("READY - calibrated limits + clipper gyro + camera-assist commands active");}
void loop(){dns.processNextRequest();server.handleClient();maintainWiFi();updateMotion();delay(1);}
