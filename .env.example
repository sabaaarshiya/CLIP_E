# Server-side only. Configure these in Vercel Project Settings > Environment Variables.
GEMINI_API_KEY=your_key_here

# Tiger Data / TrimSync devices
TIGER_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
TRIMSYNC_CAMERA_DEVICE_KEY=your_camera_device_secret
TRIMSYNC_ARM_DEVICE_KEY=your_arm_device_secret
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=your_voice_id
PRESAGE_API_KEY=your_presage_key
PRESAGE_API_URL=use_exact_supported_presage_endpoint
