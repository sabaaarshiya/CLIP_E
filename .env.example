# Server-side only. Configure this in Vercel Project Settings > Environment Variables.
GEMINI_API_KEY=your_key_here

# Bridge-free Clip-E robot camera
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
TRIMSYNC_CAMERA_DEVICE_KEY=use_the_same_long_secret_on_camera_esp32

ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=your_voice_id
PRESAGE_API_KEY=your_presage_key
PRESAGE_API_URL=use_exact_supported_presage_endpoint
